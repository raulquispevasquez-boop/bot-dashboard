  "https://10.30.4.124/Web/Trends/GetTrendLibraryTree": "\r\n\r\n<!DOCTYPE html>\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<!-- X-UA-Compatible tag must be at the top of the head section, or else it may be ignored by the browser. -->\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\" />\r\n<meta charset=\"utf-8\" />\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n<link rel=\"shortcut icon\" href=\"/SystemDataService/Content/Images/favicon.ico\" type=\"image/x-icon\" />\r\n<link rel=\"icon\" href=\"/SystemDataService/Content/Images/favicon.ico\" type=\"image/x-icon\" />\r\n<title>Power Monitoring Expert</title>\r\n<!-- **** Standard Content: BaseLibraries-Script-->\r\n<script src=\"/SystemDataService/Content/External/BaseLibraries-Script?v=nVZ_atksKgw9pu_u0QsJMjvuH37z5amfyG2d6lomBwg1\"></script>\r\n<!-- **** Standard Content: jQuery-Style-->\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/SystemDataService/Content/External/jquery/styles/jQuery-Style?v=ZfjmsvFTR-DjP5jRHUYjLitjVUkoaifhtanLEMLu4T41\"/>\r\n<!-- **** Standard Content: jQuery-Script-->\r\n<script src=\"/SystemDataService/Content/External/jquery/jQuery-Script?v=dJiYKMV4Tv1mu6dOor1Zqar-NqU6bTtk7lbNnuCo8ZI1\"></script>\r\n<link href=\"Authentication/loginpage.css\" rel=\"stylesheet\" />\r\n    <style type=\"text/css\">\r\n        .ui-dialog .ui-dialog-buttonpane {\r\n\t        text-align: left;\r\n\t        border: 0px 0px 0px 0px;\r\n\t        background: #f7f7f7;\r\n\t        margin-top: 0px !important;\r\n\t        padding: 0px;\r\n\t\t\tfont-weight: normal;\r\n\t\t\tfont-size: 14px;\r\n        }\r\n\t\t.ui-button\r\n\t\t{\t\t\t\r\n\t\t\tpadding: 5px 40px 5px 40px;\r\n\t\t\tborder: 0px;\r\n\t\t\tbackground-image: none;\r\n\t\t\toutline-width: 0px !important;\r\n\t\t}\r\n        .ui-widget.ui-widget-content {\r\n\t        border : 0px;\t\t\t\r\n\t\t\tfont-family: Arial,Verdana,sans-serif;\r\n\t\t\tfont-weight: normal;\r\n\t\t\tfont-size: 13.2px;\r\n\t\t\tmin-height: auto !important;\r\n\t\t\tcolor:#333333;\r\n        }\r\n\t\t.ui-dialog-content.ui-widget-content {\r\n\t\t\t\tpadding-top: 15px ;\r\n\t\t\t\tpadding-bottom: 15px ;\r\n\t\t\t    min-height: auto !important;\r\n        }\r\n        .ui-dialog-titlebar-close {  \r\n            display: none; \r\n        }  \r\n\t\t.ui-dialog .ui-dialog-titlebar {\r\n\t\t\tborder-radius: 0px;\r\n\t\t\tborder-top-left-radius: 3px;\r\n\t\t\tborder-top-right-radius: 3px;\r\n\t\t\tborder: 0px;\r\n\t\t\tcolor: #fff;\r\n\t\t\tfont-weight: normal;\r\n\t\t\tfont-size: 14px;\r\n\t\t\tpadding: 5px 0px 3px 10px;\r\n\t\t\tbackground-image: none;\r\n\t\t}\r\n    </style>\r\n\t<script type=\"text/javascript\">  \r\n        function DialogForPopupMessage(msgtitle, message, controlToFocus, redirecturl) {\r\n            $(\"#msgDialogAlert\").dialog({\r\n                autoOpen: false,\r\n                modal: true,\r\n                title: msgtitle,\r\n                closeOnEscape: true,\r\n                width: \"40%\",\r\n                buttons: [\r\n                    {\r\n                        text: \"OK\",\r\n                        click: function () {\r\n                            $(this).dialog(\"close\");\r\n                            if (controlToFocus != null)\r\n                                controlToFocus.focus();\r\n                            location.href = redirecturl;\r\n                        }\r\n                    }],\r\n                close: function () {\r\n                    $(\"#strongPasswordWarningMsg\").html(\"\");\r\n                    if (controlToFocus != null)\r\n                        controlToFocus.focus();\r\n                },\r\n                show: { effect: \"clip\", duration: 200 }\r\n            }).prev(\".ui-dialog-titlebar\").css(\"background\", \"#3dcd58\").next(\".ui-dialog-content\").css(\"background\", \"#f7f7f7\");\r\n            var img = document.createElement(\"img\");\r\n            img.src = \"/SystemDataService/Content/Images/warning_32.png\";\r\n            $(\"#strongPasswordWarningMsg\").html(img).append('&nbsp;&nbsp;&nbsp;').append('<span>' + message + '</span>');\r\n            $(\"#msgDialogAlert\").dialog(\"open\");\r\n        };\r\n\r\n    </script>\r\n<title>\r\n\r\n</title></head>\r\n<body class=\"greyBackground\">\r\n\r\n    <script>\r\n        // Don't show the noJavaScriptMessage if JavaScript and JQuery are working as expected.\r\n        $(\"<style>div.login_dlg div.noJavaScriptMessage{display:none;}</style>\").appendTo(\"head\");\r\n    </script>\r\n\r\n    <div class=\"login_dlg\">\r\n        <div class=\"gradient\"></div>\r\n        <div class=\"copyrightBox\">\r\n            <div class=\"noJavaScriptMessage\">No se ha podido iniciar la sesi&#243;n porque JavaScript no est&#225; habilitado en el navegador, Habil&#237;telo y vuelva a iniciar las aplicaciones web.</div>\r\n            <div class=\"copyrightText\">Copyright &#169; 2023 Schneider Electric. All Rights Reserved.</div>\r\n        </div>\r\n        <div class=\"loginBox\">\r\n\r\n            <div id=\"logOnForm\">\r\n                <div id=\"manualAuth\">\r\n                    <div class='logOnValidationSummary'><div class=\"validation-summary-errors\"></div></div>\r\n                    <div class=\"editor-field\">\r\n                        <input id=\"UserName\" name=\"UserName\" placeholder=\"Nombre del usuario\" type=\"text\" autocomplete=\"off\" />\r\n                    </div>\r\n                    <div class=\"editor-field\">\r\n                        <input id=\"Password\" name=\"Password\" placeholder=\"Contrase&#241;a\" type=\"password\" autocomplete=\"off\" />\r\n                    </div>\r\n                    <div>\r\n                        <input class=\"okButton\" id=\"logOnFormSubmitButton\" type=\"submit\" value=\"Iniciar sesi&#243;n\"/>\r\n                    </div>\r\n                </div>\r\n                \r\n                <div id=\"mfaAuth\" style=\"display:none\">\r\n                    <div class='logOnValidationSummary'><div class=\"validation-summary-errors\"></div></div>\r\n                    <div class=\"editor-field\">\r\n                        \r\n                    </div>\r\n                    <div class=\"editor-field\">\r\n                        <input id=\"ValidationCode\" name=\"ValidationCode\" placeholder=\"C&#243;digo de validaci&#243;n\" type=\"text\" autocomplete=\"off\" />\r\n                        <input id=\"mfaTokenId\" type=\"hidden\"/>\r\n                    </div>\r\n                    <div>\r\n                        <input class=\"mfaButton\" id=\"mfaFormSubmitButton\" type=\"submit\" value=\"Iniciar sesi&#243;n\"/>\r\n                    </div>\r\n                </div>\r\n\r\n                <div id=\"WinAuth\">\r\n                    <a href=\"/Web/Auto\">Usar mis credenciales de Windows</a>\r\n                </div>\r\n\r\n                <div style=\"display: none;\" id=\"Authenticating\">Autenticando...</div>\r\n\t\t\t\t<div id=\"msgDialogAlert\" style=\"display: none; text-align: left; vertical-align: central; \"> \r\n                    <div id=\"strongPasswordWarningMsg\" style=\"display:flex\"></div>\r\n                </div>\r\n            </div>\r\n            <div class=\"customerRegistrationInfoBox\">\r\n                <div class=\"customerRegistrationTextBold customerRegistrationText\">Sistema no registrado</div>\r\n                <div class=\"customerRegistrationText\"></div>\r\n            </div>\r\n        </div>\r\n        <div class=\"topBar\"></div>\r\n    </div>\r\n\r\n    <script>\r\n        // this key is shared with the framework (framework.ts).\r\n        var authLoginKey = 'Auth_Login';\r\n\r\n        var thisPageClickedLogin = false;\r\n        var systemDataService = '/SystemDataService/';\r\n        var standardUserAuthenticationEnabled = true;\r\n        var windowsManuallyAuthenticationEnabled = true;\r\n        var windowsOneClickAuthenticationEnabled = true;\r\n\r\n        // the common framework will fire this event during framework initialization. \r\n        $(window).on('storage', function (event) {\r\n            // We do not want to auto login if it was this page that clicked login.\r\n            if (thisPageClickedLogin) return;\r\n            try {\r\n                var originalEvent = event.originalEvent;\r\n                if (originalEvent && originalEvent.key === authLoginKey && window.location.href.toLocaleLowerCase().indexOf('returnurl=') >= 0) {\r\n\r\n                    // We have just received notification from another window that they attempted to login and we have a return Url\r\n                    // param on the URL.\r\n                    var localStorageAuthValue = originalEvent.newValue;\r\n                    var authTime = new Date(parseInt(localStorageAuthValue));\r\n                    if ((new Date().getTime() - authTime.getTime()) < 2000) {\r\n                        // Login occurred within 2000ms, we can accept this.\r\n\r\n                        //We will try to \"refresh\" 1 time, if we are authorized we will bounce back to our return url.\r\n                        lockForm(true);\r\n                        window.location.reload(false);\r\n                    }\r\n                }\r\n            } catch (ex) {\r\n                // nothing on error, just don't auto login.\r\n            }\r\n        });\r\n\r\n        var authDialogHtml = \"\";\r\n\r\n        $(document).ready(function () {\r\n\r\n            registerOfflinePage();\r\n\r\n            if (authDialogHtml) {\r\n\r\n                $(\".login_dlg\").hide();\r\n\r\n                $('<div />', { 'class': 'auth_dlg' }).appendTo($('body'));\r\n\r\n                var $authInner = $(document.createElement('div'));\r\n                $authInner.addClass(\"auth_inner\");\r\n                $authInner.html(authDialogHtml);\r\n                $('.auth_dlg').append($authInner);\r\n\r\n                var $continueButton = $(document.createElement('button'));\r\n                $continueButton.addClass(\"cont_btn\");\r\n                $continueButton.text(\"Continuar\");\r\n                $continueButton.click(function () {\r\n                    $(\".auth_dlg\").fadeOut(750);\r\n                    $(\".login_dlg\").show();\r\n                    logonFormOnLoad();\r\n                });\r\n\r\n                var $exitButton = $(document.createElement('button'));\r\n                $exitButton.addClass(\"exit_btn\");\r\n                $exitButton.text(\"Salir\");\r\n                $exitButton.attr(\"title\",\"Cerrar la pesta&#241;a del navegador para salir del sistema\");\r\n                $exitButton.prop('autofocus', true);\r\n                $exitButton.click(function () {\r\n                    location.href = 'about:blank';\r\n                });\r\n\r\n                $authInner.append($continueButton);\r\n                $authInner.append($exitButton);\r\n\r\n            } else {\r\n                logonFormOnLoad();\r\n            }\r\n\r\n            $('#logOnFormSubmitButton').click(logonFormOnSubmit);\r\n            $('#mfaFormSubmitButton').click(validationCodeSubmit);\r\n\r\n            // show or hide sections of the page depending on what authentication options are enabled.\r\n            if (standardUserAuthenticationEnabled || windowsManuallyAuthenticationEnabled) {\r\n                $('#manualAuth').show();\r\n            } else {\r\n                $('#manualAuth').hide();\r\n            }\r\n            if (windowsOneClickAuthenticationEnabled) {\r\n                $('#WinAuth').show();\r\n            } else {\r\n                $('#WinAuth').hide();\r\n            }\r\n\r\n        });\r\n\r\n        function logonFormOnLoad() {\r\n\r\n            // set the focus\r\n            if (!$(\"#UserName\").val()) {\r\n                $(\"#UserName\").trigger('focus');\r\n            } else {\r\n                $(\"#Password\").trigger('focus');\r\n            }\r\n\r\n            // allow enter to mean \"submit form\"\r\n            $(\"#UserName, #Password\").on('keyup', function (e) {\r\n                if (e.keyCode === 13) {\r\n                    $('#logOnFormSubmitButton').click();\r\n                }\r\n            });\r\n\r\n            // handle windows \"one click\" authentication\r\n            $('#WinAuth').click(logOnViaWinAuthClick);\r\n\r\n            setTimeout(function () {\r\n                $('.login_dlg').addClass('active');\r\n            }, 1500);\r\n\r\n            // display an error message, if specified on the URL\r\n            setValidationErrorFromQuerystring();\r\n        }\r\n\r\n        function logonFormOnSubmit() {\r\n            // trim whitespace from user name field, and get the values.\r\n            $('#UserName').val($('#UserName').val().trim());\r\n            var userName = $('#UserName').val();\r\n            var password = $('#Password').val();\r\n\r\n            // quick fail if blank username or password\r\n            if (userName.length === 0) {\r\n                setValidateError(\"Introduzca un nombre de usuario.\");\r\n                $('#UserName').trigger('focus');\r\n                return;\r\n            }\r\n            if (password.length === 0) {\r\n                setValidateError(\"Introduzca una contraseña.\");\r\n                $(\"#Password\").trigger('focus');\r\n                return;\r\n            }\r\n\r\n            lockForm(true);\r\n\r\n            var data = {\r\n                \"userName\": userName,\r\n                \"password\": password,\r\n                \"returnUrl\": getReturnUrl(),\r\n                \"setAuthCookie\": true\r\n            };\r\n\r\n            $.ajax({\r\n                url: systemDataService + 'Security/ValidateCredentials',\r\n                type: 'POST',\r\n                contentType: 'application/json',\r\n                dataType: 'json',\r\n                data: JSON.stringify(data),\r\n                cache: false,\r\n                headers: {\r\n                    \"Anti-Forgery-Token\": \"L0I28-mujFzMV7okaeJSdQZVtqz_CXRE7-BB7oAuEOkklAiLAtfQX9YBO8gv--FAG4d-TBn4mnt2GWjYIXHp-P5zbBn1M5fztLsAqa5Y_Q41:K6ReEP-d3ddeeyVK3Gde-DBuekKA5O67sGfIvlHtwdnmFgnFtrUoVYaLj3U4JDrkPvKbrgIhGhpO2HGWrT5YiIvgB3P0Jlz2unBxd0IVLkI1\"\r\n                }\r\n            })\r\n                .done(parseResponse)\r\n                .fail(errorResponse);\r\n\r\n\r\n            // Clear the password, for security\r\n            $('#Password').val('');\r\n        }\r\n\r\n        function validationCodeSubmit() {\r\n            // trim whitespace and get the values.\r\n            var mfaTokenId = $('#mfaTokenId').val();\r\n            var validationCode = $('#ValidationCode').val().trim();\r\n\r\n            // quick fail if blank code\r\n            if (validationCode.length === 0) {\r\n                setValidateError(\"Introduzca el código de validación.\");\r\n                $(\"#ValidationCode\").trigger('focus');\r\n                return;\r\n            }\r\n\r\n            lockForm(true);\r\n\r\n            var data = {\r\n                \"mfaTokenId\": mfaTokenId,\r\n                \"validationCode\": validationCode,\r\n                \"returnUrl\": getReturnUrl(),\r\n                \"setAuthCookie\": true\r\n            };\r\n\r\n            $.ajax({\r\n                url: systemDataService + 'Security/ValidateTwoFactorAuthentication',\r\n                type: 'POST',\r\n                contentType: 'application/json',\r\n                dataType: 'json',\r\n                cache: false,\r\n                data: JSON.stringify(data),\r\n                headers: {\r\n                    \"Anti-Forgery-Token\": \"iairPadTprZ_pJJiV3__Y6efSuYRtDHO3jx3_JpAKhGIcgBLZ6f9ugca5I72evivue1j-HICtNTKXePzO2CSZOyKXu0JmdQ6hsggopaQ_oU1:1sonhn3SI4mJ_EvYm8l-TuWXpW0b_-DE_tmtr6zqSBW3wEfBK-qRaaN4HtynYPEpddp5m7SYxdxyREJ8qwvvChdkWKKPOHHSYZcGwAIXzTQ1\"\r\n                }\r\n            })\r\n                .done(parseResponse)\r\n                .fail(errorResponse);\r\n\r\n\r\n            // Clear the password, for security\r\n            $('#Password').val('');\r\n        }\r\n\r\n        function logOnViaWinAuthClick(event) {\r\n            event.preventDefault();\r\n            lockForm(true);\r\n\r\n            // Windows Auth URL\r\n            var url = $('#WinAuth a').attr('href');\r\n            var returnUrl = encodeURIComponent(getReturnUrl());\r\n\r\n            if (url.indexOf('?') < 0) {\r\n                url += '?ReturnUrl=' + returnUrl;\r\n            } else {\r\n                url += '&ReturnUrl=' + returnUrl;\r\n            }\r\n\r\n            document.location = url;\r\n        }\r\n\r\n        function parseResponse(data) {\r\n            if (data.ValidationCodeRequired) {\r\n                lockForm(false);\r\n                $('#mfaTokenId').val(data.MfaTokenId);\r\n                promptForValidationCode();\r\n            } else if (data.IsValid) {\r\n                if (data.FailureMessage == 'PasswordNotStrong') {\r\n                    msgtitle =  \"Iniciar sesión\";\r\n                    message =  \"Está utilizando una contraseña más débil y debe cambiarla por otra que cumpla la política de contraseñas más seguras. Póngase en contacto con el administrador o supervisor del sistema para cambiar la contraseña.\";\r\n                    DialogForPopupMessage(msgtitle, message, null, data.ReturnUrl);\r\n\r\n                }\r\n                else\r\n                    location.href = data.ReturnUrl;\r\n            } else {\r\n                lockForm(false);\r\n                setValidateError(data.FailureMessage);\r\n            }\r\n        }\r\n\r\n        // Querystring errors come in by key. (We can't let users put messages directly on the URL.)\r\n        function setValidationErrorFromQuerystring() {\r\n\r\n            var message = getUrlParameter('Message') || '';\r\n\r\n            switch (message.toUpperCase().trim()) {\r\n                case \"TIMEOUT\":\r\n                    message = \"Se ha cerrado automáticamente su sesión por falta de actividad.\";\r\n                    break;\r\n                case \"INVALIDUSER\": // this is when a user is logged off because their credentials are no longer valid\r\n                    message = \"Se ha cerrado sesión automáticamente porque sus credenciales ya no son válidas.\";\r\n                    break;\r\n                case \"401\": // this is when a \"one-click\" user enters invalid credentials and finally gives up\r\n                    message = \"El nombre de usuario o la contraseña introducidos no son válidos. Inténtelo de nuevo.\";\r\n                    break;\r\n                case \"WINDOWSUSERNOACCESS\": // this is when a one-click user doesn't have access to the product.\r\n                    message = \"No tiene permiso para iniciar sesión. Póngase en contacto con el administrador del sistema o utilice una cuenta diferente.\";\r\n                    break;\r\n                default:\r\n                    message = \"\";\r\n                    break;\r\n            }\r\n\r\n            setValidateError(message);\r\n        }\r\n\r\n        // Display the text in the validation area of the page.\r\n        function setValidateError(string) {\r\n            $('.validation-summary-errors').text(string);\r\n        }\r\n\r\n        function errorResponse(data) {\r\n            lockForm(false);\r\n            setValidateError(\"Error inesperado al intentar autenticar el usuario.\");\r\n        }\r\n\r\n        function getReturnUrl() {\r\n            var returnUrl = getUrlParameter('returnUrl');\r\n            if (returnUrl) {\r\n\r\n                // There is a case where the redirectUrl does not have a hash value, but the current URL does. This\r\n                // seems to be an issue with IIS not encoding the # symbol when redirecting to an auth page.\r\n                if (returnUrl.indexOf('#') < 0) {\r\n                    returnUrl += location.hash;\r\n                }\r\n            }\r\n\r\n            return returnUrl;\r\n        }\r\n\r\n        var originalLogonBackgroundColor = '';\r\n        function lockForm(lockOn) {\r\n\r\n            $(\".validation-summary-errors\").text('');\r\n\r\n            // We lock the inputs if requested OR if manual authentication is totally disabled (i.e. only One-click)\r\n            lockOn = lockOn || (!windowsManuallyAuthenticationEnabled && !standardUserAuthenticationEnabled);\r\n\r\n            if (lockOn) {\r\n                originalLogonBackgroundColor = $('.okButton').css('background-color');\r\n                $('.okButton').css('background-color', '#aaa');\r\n                $(\"#logOnFormSubmitButton\").attr('disabled', 'disabled');\r\n                $(\"#logOnFormSubmitButton\").css('cursor', 'default');\r\n                $(\"#UserName\").attr('disabled', 'disabled');\r\n                $(\"#Password\").attr('disabled', 'disabled'); // prevents the value from being posted to the server\r\n\r\n                $('#WinAuth a').hide();\r\n                $('#Authenticating').fadeIn(800);\r\n            } else {\r\n                $('#Authenticating').hide();\r\n                $('#WinAuth a').show();\r\n                $('.okButton').css('background-color', originalLogonBackgroundColor);\r\n                $(\"#logOnFormSubmitButto",
  "https://10.30.4.124/SystemDataService/api/sources": "<!DOCTYPE html>\r\n<html>\r\n    <head>\r\n        <title>The resource cannot be found.</title>\r\n        <meta name=\"viewport\" content=\"width=device-width\" />\r\n        <style>\r\n         body {font-family:\"Verdana\";font-weight:normal;font-size: .7em;color:black;} \r\n         p {font-family:\"Verdana\";font-weight:normal;color:black;margin-top: -5px}\r\n         b {font-family:\"Verdana\";font-weight:bold;color:black;margin-top: -5px}\r\n         H1 { font-family:\"Verdana\";font-weight:normal;font-size:18pt;color:red }\r\n         H2 { font-family:\"Verdana\";font-weight:normal;font-size:14pt;color:maroon }\r\n         pre {font-family:\"Consolas\",\"Lucida Console\",Monospace;font-size:11pt;margin:0;padding:0.5em;line-height:14pt}\r\n         .marker {font-weight: bold; color: black;text-decoration: none;}\r\n         .version {color: gray;}\r\n         .error {margin-bottom: 10px;}\r\n         .expandable { text-decoration:underline; font-weight:bold; color:navy; cursor:pointer; }\r\n         @media screen and (max-width: 639px) {\r\n          pre { width: 440px; overflow: auto; white-space: pre-wrap; word-wrap: break-word; }\r\n         }\r\n         @media screen and (max-width: 479px) {\r\n          pre { width: 280px; }\r\n         }\r\n        </style>\r\n    </head>\r\n\r\n    <body bgcolor=\"white\">\r\n\r\n            <span><H1>Server Error in '/SystemDataService' Application.<hr width=100% size=1 color=silver></H1>\r\n\r\n            <h2> <i>The resource cannot be found.</i> </h2></span>\r\n\r\n            <font face=\"Arial, Helvetica, Geneva, SunSans-Regular, sans-serif \">\r\n\r\n            <b> Description: </b>HTTP 404. The resource you are looking for (or one of its dependencies) could have been removed, had its name changed, or is temporarily unavailable. &nbsp;Please review the following URL and make sure that it is spelled correctly.\r\n            <br><br>\r\n\r\n            <b> Requested URL: </b>/SystemDataService/api/sources<br><br>\r\n\r\n            </font>\r\n\r\n    </body>\r\n</html>\r\n",
  "https://10.30.4.124/Dashboards/data/gadget/3ff85c2d-fb01-4bd2-969f-896f6779438d-data": "\r\n\r\n<!DOCTYPE html>\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<!-- X-UA-Compatible tag must be at the top of the head section, or else it may be ignored by the browser. -->\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\" />\r\n<meta charset=\"utf-8\" />\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n<link rel=\"shortcut icon\" href=\"/SystemDataService/Content/Images/favicon.ico\" type=\"image/x-icon\" />\r\n<link rel=\"icon\" href=\"/SystemDataService/Content/Images/favicon.ico\" type=\"image/x-icon\" />\r\n<title>Power Monitoring Expert</title>\r\n<!-- **** Standard Content: BaseLibraries-Script-->\r\n<script src=\"/SystemDataService/Content/External/BaseLibraries-Script?v=nVZ_atksKgw9pu_u0QsJMjvuH37z5amfyG2d6lomBwg1\"></script>\r\n<!-- **** Standard Content: jQuery-Style-->\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/SystemDataService/Content/External/jquery/styles/jQuery-Style?v=ZfjmsvFTR-DjP5jRHUYjLitjVUkoaifhtanLEMLu4T41\"/>\r\n<!-- **** Standard Content: jQuery-Script-->\r\n<script src=\"/SystemDataService/Content/External/jquery/jQuery-Script?v=dJiYKMV4Tv1mu6dOor1Zqar-NqU6bTtk7lbNnuCo8ZI1\"></script>\r\n<link href=\"Authentication/loginpage.css\" rel=\"stylesheet\" />\r\n    <style type=\"text/css\">\r\n        .ui-dialog .ui-dialog-buttonpane {\r\n\t        text-align: left;\r\n\t        border: 0px 0px 0px 0px;\r\n\t        background: #f7f7f7;\r\n\t        margin-top: 0px !important;\r\n\t        padding: 0px;\r\n\t\t\tfont-weight: normal;\r\n\t\t\tfont-size: 14px;\r\n        }\r\n\t\t.ui-button\r\n\t\t{\t\t\t\r\n\t\t\tpadding: 5px 40px 5px 40px;\r\n\t\t\tborder: 0px;\r\n\t\t\tbackground-image: none;\r\n\t\t\toutline-width: 0px !important;\r\n\t\t}\r\n        .ui-widget.ui-widget-content {\r\n\t        border : 0px;\t\t\t\r\n\t\t\tfont-family: Arial,Verdana,sans-serif;\r\n\t\t\tfont-weight: normal;\r\n\t\t\tfont-size: 13.2px;\r\n\t\t\tmin-height: auto !important;\r\n\t\t\tcolor:#333333;\r\n        }\r\n\t\t.ui-dialog-content.ui-widget-content {\r\n\t\t\t\tpadding-top: 15px ;\r\n\t\t\t\tpadding-bottom: 15px ;\r\n\t\t\t    min-height: auto !important;\r\n        }\r\n        .ui-dialog-titlebar-close {  \r\n            display: none; \r\n        }  \r\n\t\t.ui-dialog .ui-dialog-titlebar {\r\n\t\t\tborder-radius: 0px;\r\n\t\t\tborder-top-left-radius: 3px;\r\n\t\t\tborder-top-right-radius: 3px;\r\n\t\t\tborder: 0px;\r\n\t\t\tcolor: #fff;\r\n\t\t\tfont-weight: normal;\r\n\t\t\tfont-size: 14px;\r\n\t\t\tpadding: 5px 0px 3px 10px;\r\n\t\t\tbackground-image: none;\r\n\t\t}\r\n    </style>\r\n\t<script type=\"text/javascript\">  \r\n        function DialogForPopupMessage(msgtitle, message, controlToFocus, redirecturl) {\r\n            $(\"#msgDialogAlert\").dialog({\r\n                autoOpen: false,\r\n                modal: true,\r\n                title: msgtitle,\r\n                closeOnEscape: true,\r\n                width: \"40%\",\r\n                buttons: [\r\n                    {\r\n                        text: \"OK\",\r\n                        click: function () {\r\n                            $(this).dialog(\"close\");\r\n                            if (controlToFocus != null)\r\n                                controlToFocus.focus();\r\n                            location.href = redirecturl;\r\n                        }\r\n                    }],\r\n                close: function () {\r\n                    $(\"#strongPasswordWarningMsg\").html(\"\");\r\n                    if (controlToFocus != null)\r\n                        controlToFocus.focus();\r\n                },\r\n                show: { effect: \"clip\", duration: 200 }\r\n            }).prev(\".ui-dialog-titlebar\").css(\"background\", \"#3dcd58\").next(\".ui-dialog-content\").css(\"background\", \"#f7f7f7\");\r\n            var img = document.createElement(\"img\");\r\n            img.src = \"/SystemDataService/Content/Images/warning_32.png\";\r\n            $(\"#strongPasswordWarningMsg\").html(img).append('&nbsp;&nbsp;&nbsp;').append('<span>' + message + '</span>');\r\n            $(\"#msgDialogAlert\").dialog(\"open\");\r\n        };\r\n\r\n    </script>\r\n<title>\r\n\r\n</title></head>\r\n<body class=\"greyBackground\">\r\n\r\n    <script>\r\n        // Don't show the noJavaScriptMessage if JavaScript and JQuery are working as expected.\r\n        $(\"<style>div.login_dlg div.noJavaScriptMessage{display:none;}</style>\").appendTo(\"head\");\r\n    </script>\r\n\r\n    <div class=\"login_dlg\">\r\n        <div class=\"gradient\"></div>\r\n        <div class=\"copyrightBox\">\r\n            <div class=\"noJavaScriptMessage\">No se ha podido iniciar la sesi&#243;n porque JavaScript no est&#225; habilitado en el navegador, Habil&#237;telo y vuelva a iniciar las aplicaciones web.</div>\r\n            <div class=\"copyrightText\">Copyright &#169; 2023 Schneider Electric. All Rights Reserved.</div>\r\n        </div>\r\n        <div class=\"loginBox\">\r\n\r\n            <div id=\"logOnForm\">\r\n                <div id=\"manualAuth\">\r\n                    <div class='logOnValidationSummary'><div class=\"validation-summary-errors\"></div></div>\r\n                    <div class=\"editor-field\">\r\n                        <input id=\"UserName\" name=\"UserName\" placeholder=\"Nombre del usuario\" type=\"text\" autocomplete=\"off\" />\r\n                    </div>\r\n                    <div class=\"editor-field\">\r\n                        <input id=\"Password\" name=\"Password\" placeholder=\"Contrase&#241;a\" type=\"password\" autocomplete=\"off\" />\r\n                    </div>\r\n                    <div>\r\n                        <input class=\"okButton\" id=\"logOnFormSubmitButton\" type=\"submit\" value=\"Iniciar sesi&#243;n\"/>\r\n                    </div>\r\n                </div>\r\n                \r\n                <div id=\"mfaAuth\" style=\"display:none\">\r\n                    <div class='logOnValidationSummary'><div class=\"validation-summary-errors\"></div></div>\r\n                    <div class=\"editor-field\">\r\n                        \r\n                    </div>\r\n                    <div class=\"editor-field\">\r\n                        <input id=\"ValidationCode\" name=\"ValidationCode\" placeholder=\"C&#243;digo de validaci&#243;n\" type=\"text\" autocomplete=\"off\" />\r\n                        <input id=\"mfaTokenId\" type=\"hidden\"/>\r\n                    </div>\r\n                    <div>\r\n                        <input class=\"mfaButton\" id=\"mfaFormSubmitButton\" type=\"submit\" value=\"Iniciar sesi&#243;n\"/>\r\n                    </div>\r\n                </div>\r\n\r\n                <div id=\"WinAuth\">\r\n                    <a href=\"/Web/Auto\">Usar mis credenciales de Windows</a>\r\n                </div>\r\n\r\n                <div style=\"display: none;\" id=\"Authenticating\">Autenticando...</div>\r\n\t\t\t\t<div id=\"msgDialogAlert\" style=\"display: none; text-align: left; vertical-align: central; \"> \r\n                    <div id=\"strongPasswordWarningMsg\" style=\"display:flex\"></div>\r\n                </div>\r\n            </div>\r\n            <div class=\"customerRegistrationInfoBox\">\r\n                <div class=\"customerRegistrationTextBold customerRegistrationText\">Sistema no registrado</div>\r\n                <div class=\"customerRegistrationText\"></div>\r\n            </div>\r\n        </div>\r\n        <div class=\"topBar\"></div>\r\n    </div>\r\n\r\n    <script>\r\n        // this key is shared with the framework (framework.ts).\r\n        var authLoginKey = 'Auth_Login';\r\n\r\n        var thisPageClickedLogin = false;\r\n        var systemDataService = '/SystemDataService/';\r\n        var standardUserAuthenticationEnabled = true;\r\n        var windowsManuallyAuthenticationEnabled = true;\r\n        var windowsOneClickAuthenticationEnabled = true;\r\n\r\n        // the common framework will fire this event during framework initialization. \r\n        $(window).on('storage', function (event) {\r\n            // We do not want to auto login if it was this page that clicked login.\r\n            if (thisPageClickedLogin) return;\r\n            try {\r\n                var originalEvent = event.originalEvent;\r\n                if (originalEvent && originalEvent.key === authLoginKey && window.location.href.toLocaleLowerCase().indexOf('returnurl=') >= 0) {\r\n\r\n                    // We have just received notification from another window that they attempted to login and we have a return Url\r\n                    // param on the URL.\r\n                    var localStorageAuthValue = originalEvent.newValue;\r\n                    var authTime = new Date(parseInt(localStorageAuthValue));\r\n                    if ((new Date().getTime() - authTime.getTime()) < 2000) {\r\n                        // Login occurred within 2000ms, we can accept this.\r\n\r\n                        //We will try to \"refresh\" 1 time, if we are authorized we will bounce back to our return url.\r\n                        lockForm(true);\r\n                        window.location.reload(false);\r\n                    }\r\n                }\r\n            } catch (ex) {\r\n                // nothing on error, just don't auto login.\r\n            }\r\n        });\r\n\r\n        var authDialogHtml = \"\";\r\n\r\n        $(document).ready(function () {\r\n\r\n            registerOfflinePage();\r\n\r\n            if (authDialogHtml) {\r\n\r\n                $(\".login_dlg\").hide();\r\n\r\n                $('<div />', { 'class': 'auth_dlg' }).appendTo($('body'));\r\n\r\n                var $authInner = $(document.createElement('div'));\r\n                $authInner.addClass(\"auth_inner\");\r\n                $authInner.html(authDialogHtml);\r\n                $('.auth_dlg').append($authInner);\r\n\r\n                var $continueButton = $(document.createElement('button'));\r\n                $continueButton.addClass(\"cont_btn\");\r\n                $continueButton.text(\"Continuar\");\r\n                $continueButton.click(function () {\r\n                    $(\".auth_dlg\").fadeOut(750);\r\n                    $(\".login_dlg\").show();\r\n                    logonFormOnLoad();\r\n                });\r\n\r\n                var $exitButton = $(document.createElement('button'));\r\n                $exitButton.addClass(\"exit_btn\");\r\n                $exitButton.text(\"Salir\");\r\n                $exitButton.attr(\"title\",\"Cerrar la pesta&#241;a del navegador para salir del sistema\");\r\n                $exitButton.prop('autofocus', true);\r\n                $exitButton.click(function () {\r\n                    location.href = 'about:blank';\r\n                });\r\n\r\n                $authInner.append($continueButton);\r\n                $authInner.append($exitButton);\r\n\r\n            } else {\r\n                logonFormOnLoad();\r\n            }\r\n\r\n            $('#logOnFormSubmitButton').click(logonFormOnSubmit);\r\n            $('#mfaFormSubmitButton').click(validationCodeSubmit);\r\n\r\n            // show or hide sections of the page depending on what authentication options are enabled.\r\n            if (standardUserAuthenticationEnabled || windowsManuallyAuthenticationEnabled) {\r\n                $('#manualAuth').show();\r\n            } else {\r\n                $('#manualAuth').hide();\r\n            }\r\n            if (windowsOneClickAuthenticationEnabled) {\r\n                $('#WinAuth').show();\r\n            } else {\r\n                $('#WinAuth').hide();\r\n            }\r\n\r\n        });\r\n\r\n        function logonFormOnLoad() {\r\n\r\n            // set the focus\r\n            if (!$(\"#UserName\").val()) {\r\n                $(\"#UserName\").trigger('focus');\r\n            } else {\r\n                $(\"#Password\").trigger('focus');\r\n            }\r\n\r\n            // allow enter to mean \"submit form\"\r\n            $(\"#UserName, #Password\").on('keyup', function (e) {\r\n                if (e.keyCode === 13) {\r\n                    $('#logOnFormSubmitButton').click();\r\n                }\r\n            });\r\n\r\n            // handle windows \"one click\" authentication\r\n            $('#WinAuth').click(logOnViaWinAuthClick);\r\n\r\n            setTimeout(function () {\r\n                $('.login_dlg').addClass('active');\r\n            }, 1500);\r\n\r\n            // display an error message, if specified on the URL\r\n            setValidationErrorFromQuerystring();\r\n        }\r\n\r\n        function logonFormOnSubmit() {\r\n            // trim whitespace from user name field, and get the values.\r\n            $('#UserName').val($('#UserName').val().trim());\r\n            var userName = $('#UserName').val();\r\n            var password = $('#Password').val();\r\n\r\n            // quick fail if blank username or password\r\n            if (userName.length === 0) {\r\n                setValidateError(\"Introduzca un nombre de usuario.\");\r\n                $('#UserName').trigger('focus');\r\n                return;\r\n            }\r\n            if (password.length === 0) {\r\n                setValidateError(\"Introduzca una contraseña.\");\r\n                $(\"#Password\").trigger('focus');\r\n                return;\r\n            }\r\n\r\n            lockForm(true);\r\n\r\n            var data = {\r\n                \"userName\": userName,\r\n                \"password\": password,\r\n                \"returnUrl\": getReturnUrl(),\r\n                \"setAuthCookie\": true\r\n            };\r\n\r\n            $.ajax({\r\n                url: systemDataService + 'Security/ValidateCredentials',\r\n                type: 'POST',\r\n                contentType: 'application/json',\r\n                dataType: 'json',\r\n                data: JSON.stringify(data),\r\n                cache: false,\r\n                headers: {\r\n                    \"Anti-Forgery-Token\": \"cr5uKxqjC7h16R9AhGr4vQ0bOzgEb_B843a-huQLr_7DCNGdaqN4BWHQ6UaVOcvJFWCl7CZbpwEZywmjrxSoJBZGR0s4jr5g32bSNdKD3CU1:USx5mFBP-O6dGLy_ZmQhoeNmKg_LwMTlOEZtzbEuRGJXAkokoCCAiCawtmPnUlOKX9DNRZqFnxOKBwzb-231d95_g4q0ycWD_H8F1_FK6js1\"\r\n                }\r\n            })\r\n                .done(parseResponse)\r\n                .fail(errorResponse);\r\n\r\n\r\n            // Clear the password, for security\r\n            $('#Password').val('');\r\n        }\r\n\r\n        function validationCodeSubmit() {\r\n            // trim whitespace and get the values.\r\n            var mfaTokenId = $('#mfaTokenId').val();\r\n            var validationCode = $('#ValidationCode').val().trim();\r\n\r\n            // quick fail if blank code\r\n            if (validationCode.length === 0) {\r\n                setValidateError(\"Introduzca el código de validación.\");\r\n                $(\"#ValidationCode\").trigger('focus');\r\n                return;\r\n            }\r\n\r\n            lockForm(true);\r\n\r\n            var data = {\r\n                \"mfaTokenId\": mfaTokenId,\r\n                \"validationCode\": validationCode,\r\n                \"returnUrl\": getReturnUrl(),\r\n                \"setAuthCookie\": true\r\n            };\r\n\r\n            $.ajax({\r\n                url: systemDataService + 'Security/ValidateTwoFactorAuthentication',\r\n                type: 'POST',\r\n                contentType: 'application/json',\r\n                dataType: 'json',\r\n                cache: false,\r\n                data: JSON.stringify(data),\r\n                headers: {\r\n                    \"Anti-Forgery-Token\": \"TWfqdwNnSllN-WoxaOVCj1nASPPYo4QWokVNMKYF1MzbYfn77bfsgAyZaDJxgHMuZUF_jNhKzO_fCAHZ3X-BMBqCVKUoA2ZnHHL3GCR8kzg1:JkkZwV-5f_MMawqHMuAhKp3J7D01uVI2nfdKTF7oaK1HNmwBGd1I28ORQWqP0Ouq3HU93A2pNRYQRio8h53X33SZtqkZG31JAXk9sKRVpHs1\"\r\n                }\r\n            })\r\n                .done(parseResponse)\r\n                .fail(errorResponse);\r\n\r\n\r\n            // Clear the password, for security\r\n            $('#Password').val('');\r\n        }\r\n\r\n        function logOnViaWinAuthClick(event) {\r\n            event.preventDefault();\r\n            lockForm(true);\r\n\r\n            // Windows Auth URL\r\n            var url = $('#WinAuth a').attr('href');\r\n            var returnUrl = encodeURIComponent(getReturnUrl());\r\n\r\n            if (url.indexOf('?') < 0) {\r\n                url += '?ReturnUrl=' + returnUrl;\r\n            } else {\r\n                url += '&ReturnUrl=' + returnUrl;\r\n            }\r\n\r\n            document.location = url;\r\n        }\r\n\r\n        function parseResponse(data) {\r\n            if (data.ValidationCodeRequired) {\r\n                lockForm(false);\r\n                $('#mfaTokenId').val(data.MfaTokenId);\r\n                promptForValidationCode();\r\n            } else if (data.IsValid) {\r\n                if (data.FailureMessage == 'PasswordNotStrong') {\r\n                    msgtitle =  \"Iniciar sesión\";\r\n                    message =  \"Está utilizando una contraseña más débil y debe cambiarla por otra que cumpla la política de contraseñas más seguras. Póngase en contacto con el administrador o supervisor del sistema para cambiar la contraseña.\";\r\n                    DialogForPopupMessage(msgtitle, message, null, data.ReturnUrl);\r\n\r\n                }\r\n                else\r\n                    location.href = data.ReturnUrl;\r\n            } else {\r\n                lockForm(false);\r\n                setValidateError(data.FailureMessage);\r\n            }\r\n        }\r\n\r\n        // Querystring errors come in by key. (We can't let users put messages directly on the URL.)\r\n        function setValidationErrorFromQuerystring() {\r\n\r\n            var message = getUrlParameter('Message') || '';\r\n\r\n            switch (message.toUpperCase().trim()) {\r\n                case \"TIMEOUT\":\r\n                    message = \"Se ha cerrado automáticamente su sesión por falta de actividad.\";\r\n                    break;\r\n                case \"INVALIDUSER\": // this is when a user is logged off because their credentials are no longer valid\r\n                    message = \"Se ha cerrado sesión automáticamente porque sus credenciales ya no son válidas.\";\r\n                    break;\r\n                case \"401\": // this is when a \"one-click\" user enters invalid credentials and finally gives up\r\n                    message = \"El nombre de usuario o la contraseña introducidos no son válidos. Inténtelo de nuevo.\";\r\n                    break;\r\n                case \"WINDOWSUSERNOACCESS\": // this is when a one-click user doesn't have access to the product.\r\n                    message = \"No tiene permiso para iniciar sesión. Póngase en contacto con el administrador del sistema o utilice una cuenta diferente.\";\r\n                    break;\r\n                default:\r\n                    message = \"\";\r\n                    break;\r\n            }\r\n\r\n            setValidateError(message);\r\n        }\r\n\r\n        // Display the text in the validation area of the page.\r\n        function setValidateError(string) {\r\n            $('.validation-summary-errors').text(string);\r\n        }\r\n\r\n        function errorResponse(data) {\r\n            lockForm(false);\r\n            setValidateError(\"Error inesperado al intentar autenticar el usuario.\");\r\n        }\r\n\r\n        function getReturnUrl() {\r\n            var returnUrl = getUrlParameter('returnUrl');\r\n            if (returnUrl) {\r\n\r\n                // There is a case where the redirectUrl does not have a hash value, but the current URL does. This\r\n                // seems to be an issue with IIS not encoding the # symbol when redirecting to an auth page.\r\n                if (returnUrl.indexOf('#') < 0) {\r\n                    returnUrl += location.hash;\r\n                }\r\n            }\r\n\r\n            return returnUrl;\r\n        }\r\n\r\n        var originalLogonBackgroundColor = '';\r\n        function lockForm(lockOn) {\r\n\r\n            $(\".validation-summary-errors\").text('');\r\n\r\n            // We lock the inputs if requested OR if manual authentication is totally disabled (i.e. only One-click)\r\n            lockOn = lockOn || (!windowsManuallyAuthenticationEnabled && !standardUserAuthenticationEnabled);\r\n\r\n            if (lockOn) {\r\n                originalLogonBackgroundColor = $('.okButton').css('background-color');\r\n                $('.okButton').css('background-color', '#aaa');\r\n                $(\"#logOnFormSubmitButton\").attr('disabled', 'disabled');\r\n                $(\"#logOnFormSubmitButton\").css('cursor', 'default');\r\n                $(\"#UserName\").attr('disabled', 'disabled');\r\n                $(\"#Password\").attr('disabled', 'disabled'); // prevents the value from being posted to the server\r\n\r\n                $('#WinAuth a').hide();\r\n                $('#Authenticating').fadeIn(800);\r\n            } else {\r\n                $('#Authenticating').hide();\r\n                $('#WinAuth a').show();\r\n                $('.okButton').css('background-color', originalLogonBackgroundColor);\r\n                $(\"#logOnFormSubmitButto"
}